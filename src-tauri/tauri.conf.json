{
  "productName": "Batch 7z Archiver",
  "version": "0.1.0",
  "identifier": "com.archivetool.app",
  "build": {
    "frontendDist": "gen",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Batch 7z Archiver",
        "width": 850,
        "height": 700,
        "resizable": true,
        "minWidth": 700,
        "minHeight": 550
      }
    ],
    "security": {
      "csp": "default-src 'self' data:; connect-src 'self' ws://localhost:*;"
    }
  },
  "bundle": {
    "active": true,
    "targets": "msi",
    "icon": ["icons/icon.ico"]
  }
}
