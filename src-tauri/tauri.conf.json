{
  "productName": "Batch Media Archiver",
  "version": "0.1.1",
  "identifier": "com.archivetool.app",
  "build": {
    "frontendDist": "gen",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Batch Media Archiver",
        "theme": "Dark",
        "width": 760,
        "height": 700,
        "resizable": true,
        "minWidth": 660,
        "minHeight": 550
      }
    ],
    "security": {
      "csp": "default-src 'self' data:; connect-src 'self' ws://localhost:*;"
    }
  },
  "bundle": {
    "active": true,
    "useLocalToolsDir": true,
    "targets": "nsis",
    "icon": ["icons/icon.ico"]
  }
}
